# DeepRAG 环境变量配置示例
# 使用方式：cp .env.example .env，然后填入真实 API Key

# === LLM 配置（2026-07-18 免费模型实测）===
# 推荐：siliconcloud（中文质量+速度）/ cerebras（超快）/ groq（高RPM）/ auto
# 降级链 get_llm_with_fallback: Cerebras → Groq → Silicon → Zhipu → Ollama
LLM_BACKEND=siliconcloud
LLM_MODEL=THUDM/GLM-Z1-9B-0414

# Cerebras（超快，日约1M tokens）https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# 备选模型: gemma-4-31b, zai-glm-4.7

# Groq（~30RPM，低延迟）https://console.groq.com
GROQ_API_KEY=
# 默认模型 llama-3.1-8b-instant；备选 qwen/qwen3.6-27b, openai/gpt-oss-120b

# 硅基流动（中文兜底，偏慢）https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=
# 默认 THUDM/GLM-Z1-9B-0414

# 智谱AI（中文 Flash）https://open.bigmodel.cn
ZHIPU_API_KEY=
# 默认 glm-4-flash

# OpenRouter free（易日限，仅备用）
OPENROUTER_API_KEY=

# Anthropic / OpenAI（可选付费）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# === 向量数据库 ===
# 中心路径（仅 chroma run --path 使用）
CHROMA_DB_PATH=./chroma_data
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8000
# 选择向量数据库后端：chromadb / qdrant / lancedb / faiss / pgvector
VECTOR_DB=qdrant

# Qdrant 配置（仅当 VECTOR_DB=qdrant 时生效）
QDRANT_MODE=server
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=deep_rag_docs
# Qdrant Cloud 鉴权（云端部署时必填，本地无需）
QDRANT_API_KEY=

# pgvector 配置（仅当 VECTOR_DB=pgvector 时生效）
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=deeprag
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres

# === Embedding 模型 ===
# 切换 Embedding 模型（修改后需重新索引知识库）
# 可选值：
#   BAAI/bge-small-zh-v1.5   — 512维/512长度/中文优化/轻量快速（默认）
#   BAAI/bge-base-zh-v1.5    — 768维/512长度/中文/平衡性价比
#   BAAI/bge-large-zh-v1.5   — 1024维/512长度/中文/高精度
#   BAAI/bge-m3              — 1024维/8192长度/多语言/三路混合检索（最强）
#   all-MiniLM-L6-v2        — 384维/256长度/英文
# bge-m3 需额外安装：pip install FlagEmbedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# === 检索配置 ===
# 启用混合检索（BM25 + 向量）
ENABLE_HYBRID_SEARCH=true

# 启用两阶段精排（CrossEncoder）
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base

# === Agentic RAG 配置 ===
# === 生产 API 安全 ===
# 生产环境务必设置；未设置时本地开发可无 Key 访问
API_KEY=
# 每 IP 每分钟请求上限
RATE_LIMIT_PER_MINUTE=60
# CORS 白名单（逗号分隔）；生产不要用 *
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# 允许索引的目录根（逗号或系统 pathsep 分隔）
INDEX_ALLOWED_ROOTS=
# 问题最大字符
MAX_QUESTION_CHARS=4000
# 审计日志路径
AUDIT_LOG_PATH=
API_HOST=0.0.0.0
API_PORT=8000

# === Self-RAG / Pipeline 节点（v2.9.x 诚实默认）===
# false（默认）= fact_check 后不 regenerate，省 5–7s；true = 质量模式可重新生成
ENABLE_SELF_RAG_LOOP=false
SELF_RAG_MAX_REGENERATE=1
# false（默认）= analyze/grade/fact_check 用 offline 规则；true = 尝试 LLM 节点
USE_LLM_PIPELINE_NODES=false

# 启用 Agentic RAG（动态工具路由）
ENABLE_AGENTIC_RAG=false

# 路由器类型：llm（智能路由，需LLM，推荐） / rule（规则路由，零延迟）
AGENTIC_ROUTER=llm

# 启用 Web 搜索兜底
ENABLE_WEB_FALLBACK=true

# 启用图检索（v2.4已内置NetworkX实现，无需Neo4j）
ENABLE_GRAPH_SEARCH=false

# 检索模式：
#   enhanced      — 增强检索（问题拒识+多路推理+重排序，默认推荐）
#   agentic       — Agent动态路由（LLMRouter选择4种工具之一）
#   hybrid        — 混合检索（BM25+向量，v1.0基线）
#   agentic_react — ReAct Agent循环（v2.4，LLM自主决策多轮检索）
RETRIEVAL_MODE=enhanced

# === 日志配置 ===
LOG_LEVEL=INFO
