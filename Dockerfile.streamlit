# Dockerfile for Railway single-service Streamlit deployment
# Multi-stage build for smaller image size

# ---- Stage 1: Builder ----
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/
COPY api.py app.py ./

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[llm,api,ui,qdrant]" && \
    pip install --no-cache-dir langchain-openai langchain-ollama psutil

# ---- Stage 2: Runtime ----
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy only application code (not tests, docs, benchmarks)
COPY --chown=appuser:appuser pyproject.toml ./
COPY --chown=appuser:appuser src/ ./src/
COPY --chown=appuser:appuser api.py app.py ./
COPY --chown=appuser:appuser start_mcp_server.py ./
COPY --chown=appuser:appuser scripts/ ./scripts/

# Switch to non-root user
USER appuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]
